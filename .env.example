# Copy to .env and fill in. Keep .env private (chmod 600 .env): it holds keys.

# The address you open Drawer at, exactly as the browser shows it. With Tailscale (README.md) it looks like
# https://your-machine.your-tailnet.ts.net. Needed for forms, the phone's home-screen app, the mic and notifications.
ORIGIN=https://your-machine.your-tailnet.ts.net

# Your time zone, for "today", dates in notes and reminders.
TZ=Europe/Madrid

# A line about you, so the filer picks titles and topics you would search for. Optional.
# DRAWER_ABOUT=Nurse in Lyon; writes in French and English; keeps shift rotas, recipes and travel links.

# ---- The model: pick ONE, or none (Drawer then works without one: search, files, sending between devices).

# 1. Claude Haiku through the Anthropic API (console.anthropic.com, pay as you go; normal use is well under
#    1 dollar a month). A Claude.ai Pro/Max subscription can NOT be used here: see README.md, "Why no Claude login".
ANTHROPIC_API_KEY=
# Dollars a month Drawer may spend on the API; past it, Drawer works on without the model until the 1st.
DRAWER_SPEND_CAP_USD=5

# 2. A local model through any OpenAI-compatible server (Ollama, LM Studio, llama.cpp, vLLM). Nothing leaves your
#    machine and nothing is billed. Used only when ANTHROPIC_API_KEY is empty.
#    Ollama on this same machine: http://host.docker.internal:11434/v1 (start Ollama with OLLAMA_HOST=0.0.0.0 and
#    OLLAMA_CONTEXT_LENGTH=16384). The `ollama` service in compose.yaml: http://ollama:11434/v1
# DRAWER_LOCAL_URL=http://host.docker.internal:11434/v1
# DRAWER_LOCAL_MODEL=qwen3.5:9b
# DRAWER_LOCAL_KEY=            only if your server asks for one
# DRAWER_LOCAL_VISION=1        if the model can see images (gemma, qwen-vl…); pictures are then sent along

# ---- Optional

# Push notifications work without setup: Drawer makes its keys on first start (in its data folder). To bring your
# own: DRAWER_VAPID_PUBLIC, DRAWER_VAPID_PRIVATE, DRAWER_VAPID_SUBJECT (mailto: or https: address).

# The port Drawer answers on, on this machine only.
# DRAWER_PORT=3000
